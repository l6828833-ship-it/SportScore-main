{
  "name": "sportscore",
  "version": "1.0.0",
  "description": "Self-hosted football data backend (API-Football proxy with caching)",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "heroku-postbuild": "mkdir -p ./.cache && mv /app/.cache/puppeteer ./.cache || true"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "1.7.9",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "mongoose": "7.8.3",
    "node-cache": "5.1.2",
    "puppeteer": "21.11.0"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-prettier": "5.2.1",
    "prettier": "3.4.2"
  }
}
